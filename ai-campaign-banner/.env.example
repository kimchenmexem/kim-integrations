# ─────────────────────────────────────────────────────────────
# AI Campaign Banner Generator — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# This file is the public template — keep it free of real secrets.
# ─────────────────────────────────────────────────────────────

# ── AI provider abstraction (campaign PLANNING / copy strategy) ──
# Which LLM writes concept strategy + visual direction. One of:
#   openai | anthropic | mock   (default when unset: mock — deterministic,
#   no network, no key; good for local dev).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── AI image generation (OPTIONAL — OFF by default) ────────
# The main deterministic campaign pipeline renders backgrounds/motifs as SVG
# and does NOT call any paid image API unless you opt in here.
#
# AI_IMAGE_PROVIDER selects the image backend for the campaign pipeline:
#   none   (DEFAULT) — no AI image generation; SVG/brand assets only.
#   openai — generate backgrounds via OpenAI Images (costs money per image).
# Leave unset (or "none") unless you specifically want auto-generated imagery.
# AI_IMAGE_PROVIDER=none
#
# Only used when AI_IMAGE_PROVIDER=openai (default model gpt-image-1, quality
# "high"). Quality: high | medium | low (gpt-image-1) or hd | standard (dall-e-3).
# When OpenAI ships gpt-image-2, set OPENAI_IMAGE_MODEL=gpt-image-2.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Route Handlers / Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix used when uploading campaign assets
CLOUDINARY_BASE_FOLDER=ai-campaign-banner

# ── Bannerbear ─────────────────────────────────────────────
BANNERBEAR_API_KEY=
# Optional: project-scoped key if using a master account
BANNERBEAR_PROJECT_ID=
# Template UIDs for each ad size. Create one template per size in Bannerbear
# and paste the UID here. The app maps a requested size → template UID.
BANNERBEAR_TEMPLATE_1200x628=
BANNERBEAR_TEMPLATE_1080x1080=
BANNERBEAR_TEMPLATE_1080x1920=

# ── App ────────────────────────────────────────────────────
# Public base URL (used for callbacks, signed downloads, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── App auth / API protection (src/middleware.ts) ──────────
# Two server-only layers, both enforced in Edge middleware (never shipped to
# the browser). See src/middleware.ts for the full contract.
#
# 1) HTTP Basic Auth — fronts the whole deployed app. The browser prompts once
#    and caches the credentials, so the UI keeps working. Leave unset in local
#    dev to disable the prompt.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
#
# 2) Internal API key — required (in production) on every MUTATION / COST
#    /api/* route: campaign generation, rendering, exports, uploads,
#    generators, QA, active-campaign/index mutation. Present it as
#    `Authorization: Bearer <key>` or `x-internal-api-key: <key>`. The
#    authenticated browser UI is allowed through via Basic Auth instead, so
#    this key never needs to live in client code. Generate with:
#      openssl rand -hex 32
BANNER_INTERNAL_API_KEY=
#
# Local-dev escape hatch ONLY. When "true" (and NODE_ENV !== production), the
# mutation guard is bypassed so the local UI can call mutation routes without
# any credentials. NEVER set this in production.
# ALLOW_UNAUTHENTICATED_DEV_API=true
#
# Optional: per-identity mutation rate limit (requests/min). Default 60.
# In-memory + per-instance — a best-effort runaway-loop backstop, not a
# distributed quota (see src/middleware.ts).
# BANNER_API_RATE_LIMIT_PER_MIN=60

# ── marketing-translator (campaign copy source) ────────────
# marketing-translator is the SINGLE source of headline / subheadline /
# cta / disclaimer for every campaign. ai-campaign-banner does not invent
# copy locally — the planner calls /api/campaign-copy and writes the
# response into each concept's copy_package before manifest construction.
#
# When MARKETING_TRANSLATOR_API_URL is unset, campaign generation fails
# instead of silently shipping local/mock text. Set this URL in every
# environment that creates real campaigns.
#
# MARKETING_TRANSLATOR_API_KEY must match CAMPAIGN_COPY_API_KEY on the
# translator side. Generate with:  openssl rand -hex 32
MARKETING_TRANSLATOR_API_URL=
MARKETING_TRANSLATOR_API_KEY=

# Staging/test-only escape hatch. Set to "1" only for intentional dry-runs
# that should use the deterministic local mock when the translator URL is
# intentionally unset. Leave unset everywhere else.
# MARKETING_TRANSLATOR_ALLOW_MOCK=

# ─── Nano Banana (Gemini 2.5 Flash Image) ─────────────────────────────
#
# Used ONLY by the /nano-banana page + /api/generate-nano-banner route.
# Standalone creative pipeline — the deterministic campaign pipeline
# (planCampaign / buildAdSpecsFromPlan) doesn't touch this key.
#
# Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Override the default image-generation model. Default is
# `gemini-2.5-flash-image` (the stable "Nano Banana"). To use newer
# models, set this to one of:
#   - gemini-3-pro-image-preview
#   - gemini-3-pro-image
#   - gemini-3.1-flash-image-preview
#   - gemini-3.1-flash-image
# List supported models for your key with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# GEMINI_IMAGE_MODEL=
